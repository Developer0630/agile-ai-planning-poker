# ==========================================
# CẤU HÌNH DATABASE (MYSQL)
# ==========================================
MYSQL_DATABASE=agile_poker
MYSQL_ROOT_PASSWORD=your_strong_password_here
MYSQL_PORT=3306

# ==========================================
# CẤU HÌNH CỔNG DỊCH VỤ (PORTS)
# ==========================================
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ==========================================
# BẢO MẬT JWT (THAY ĐỔI KHI DEPLOY)
# ==========================================
JWT_SECRET=AgilePokerSecretKeyForJwtAuthentication2026MustBeAtLeast32Chars
JWT_EXPIRATION=86400000

# ==========================================
# KẾT NỐI DỊCH VỤ AI (LLAMA-3 FASTAPI)
# ==========================================
# Dùng http://host.docker.internal:8000 nếu chạy Backend trong Docker và AI ở máy host
# Dùng http://localhost:8000 nếu chạy Backend trực tiếp trên máy local
AI_SERVICE_BASE_URL=http://host.docker.internal:8000